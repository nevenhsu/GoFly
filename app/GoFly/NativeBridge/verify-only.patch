+/// Verifies an existing remote-pairing credential without pair-setup fallback.
+/// This helper deliberately never calls `connect` or accepts a PIN callback.
+async fn verify_existing_pairing<R: idevice::remote_pairing::RpPairingSocketProvider>(
+    rpc: &mut RemotePairingClient<R>,
+    pairing_file: &mut idevice::remote_pairing::RpPairingFile,
+) -> Result<(), IdeviceError> {
+    rpc.attempt_pair_verify().await?;
+    rpc.validate_pairing(pairing_file).await?;
+    Ok(())
+}
+
+/// Opens a raw RPPairing tunnel using only an existing credential.
+/// Authentication failure is terminal: no pairing request or credential update.
+///
+/// # Safety
+/// Input pointers must be valid and non-null. Each non-null output pointer must
+/// be writable; output handles are set to NULL before any fallible work and are
+/// published together only after the complete TLS/RSD tunnel succeeds.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn tunnel_create_rppairing_verify_only(
+    addr: *const idevice_sockaddr,
+    addr_len: idevice_socklen_t,
+    hostname: *const c_char,
+    pairing_file: *mut RpPairingFileHandle,
+    out_adapter: *mut *mut AdapterHandle,
+    out_handshake: *mut *mut RsdHandshakeHandle,
+) -> *mut IdeviceFfiError {
+    unsafe {
+        if !out_adapter.is_null() { *out_adapter = null_mut(); }
+        if !out_handshake.is_null() { *out_handshake = null_mut(); }
+    }
+    if addr.is_null() || hostname.is_null() || pairing_file.is_null()
+        || out_adapter.is_null() || out_handshake.is_null()
+    {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let socket_addr = match crate::util::c_socket_to_rust(addr as *const SockAddr, addr_len) {
+        Ok(a) => a,
+        Err(e) => return ffi_err!(e),
+    };
+    let host = match unsafe { CStr::from_ptr(hostname) }.to_str() {
+        Ok(s) => s.to_string(),
+        Err(_) => return ffi_err!(IdeviceError::FfiInvalidString),
+    };
+    let rpf = unsafe { &mut (*pairing_file).0 };
+    let res = run_sync_local(async {
+        let stream = run_global_timeout(|| tokio::net::TcpStream::connect(socket_addr))
+            .await
+            .map_err(|e| IdeviceError::InternalError(format!("connect: {e}")))?;
+        let mut rpc = RemotePairingClient::new(RpPairingSocket::new(stream), &host);
+        verify_existing_pairing(&mut rpc, rpf).await?;
+        finish_tunnel(&mut rpc, socket_addr).await
+    });
+    match res {
+        Ok((adapter, handshake)) => {
+            write_result(adapter, handshake, out_adapter, out_handshake);
+            null_mut()
+        }
+        Err(e) => ffi_err!(e),
+    }
+}
