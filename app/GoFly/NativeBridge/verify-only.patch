+//! GoFly regression tests: execute real RemotePairingClient framing and crypto,
+//! with a local scripted peer. No device, credentials or network beyond loopback.
+use super::*;
+use idevice::remote_pairing::RpPairingFile;
+use tokio::io::{AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt};
+
+const HANDSHAKE: &str = r#"{"response":{"_1":{"handshake":{"_0":{}}}}}"#;
+const REJECTED: &str = r#"{"event":{"_0":{"pairingData":{"_0":{"data":"BwEC"}}}}}"#;
+// TLV state=2 + X25519 public key [9;32]; the real client performs its crypto.
+const VERIFIED_KEY: &str = r#"{"event":{"_0":{"pairingData":{"_0":{"data":"BgECAyAJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQ=="}}}}}"#;
+const VERIFIED_FINISH: &str = r#"{"event":{"_0":{"pairingData":{"_0":{"data":"BgEE"}}}}}"#;
+
+async fn frame_read<S: AsyncRead + Unpin>(socket: &mut S) -> Option<String> {
+    let mut prefix = [0; 11];
+    if socket.read_exact(&mut prefix).await.is_err() { return None; }
+    assert_eq!(&prefix[..9], b"RPPairing");
+    let count = u16::from_be_bytes([prefix[9], prefix[10]]) as usize;
+    let mut body = vec![0; count];
+    socket.read_exact(&mut body).await.unwrap();
+    Some(String::from_utf8(body).unwrap())
+}
+
+async fn frame_write<S: AsyncWrite + Unpin>(socket: &mut S, plain: &str) {
+    let body = format!(r#"{{"message":{{"plain":{{"_0":{plain}}}}},"originatedBy":"device","sequenceNumber":0}}"#);
+    socket.write_all(b"RPPairing").await.unwrap();
+    socket.write_all(&(body.len() as u16).to_be_bytes()).await.unwrap();
+    socket.write_all(body.as_bytes()).await.unwrap();
+    socket.flush().await.unwrap();
+}
+
+async fn scripted_peer<S: AsyncRead + AsyncWrite + Unpin>(mut socket: S, accepted: bool, reject_after_signing: bool) -> Vec<String> {
+    let mut sent = Vec::new();
+    sent.push(frame_read(&mut socket).await.unwrap());
+    frame_write(&mut socket, HANDSHAKE).await;
+    sent.push(frame_read(&mut socket).await.unwrap());
+    frame_write(&mut socket, if accepted { VERIFIED_KEY } else { REJECTED }).await;
+    if accepted {
+        sent.push(frame_read(&mut socket).await.unwrap());
+        frame_write(&mut socket, if reject_after_signing { REJECTED } else { VERIFIED_FINISH }).await;
+    }
+    while let Some(message) = frame_read(&mut socket).await { sent.push(message); }
+    sent
+}
+
+fn assert_verify_only(messages: &[String]) {
+    assert!(messages[0].contains("attemptPairVerify"));
+    assert!(messages[1].contains("verifyManualPairing"));
+    for message in messages {
+        assert!(!message.contains("setupManualPairing"), "unexpected setup: {message}");
+        assert!(!message.contains("pairingConsent"), "unexpected consent: {message}");
+        assert!(!message.contains("000000"), "unexpected PIN: {message}");
+    }
+}
+
+#[test]
+fn gofly_verify_only_preserves_credentials_on_success_and_rejection() {
+    for (accepted, reject_after_signing) in [(false, false), (true, false), (true, true)] {
+        run_sync_local(async {
+            let (client, peer) = tokio::io::duplex(16384);
+            let peer = tokio::spawn(scripted_peer(peer, accepted, reject_after_signing));
+            let mut credential = RpPairingFile::generate("GoFlyTest");
+            credential.alt_irk = Some(vec![7; 16]);
+            let before = credential.to_bytes();
+            let mut rpc = RemotePairingClient::new(RpPairingSocket::new(client), "GoFlyTest");
+            let result = verify_existing_pairing(&mut rpc, &mut credential).await;
+            assert_eq!(result.is_ok(), accepted && !reject_after_signing);
+            assert_eq!(credential.to_bytes(), before);
+            drop(rpc);
+            let messages = peer.await.unwrap();
+            assert_verify_only(&messages);
+            if !accepted { assert_eq!(messages.len(), 3); assert!(messages[2].contains("pairVerifyFailed")); }
+        });
+    }
+}
+
+#[test]
+fn gofly_verify_only_export_rejection_has_null_outputs_and_unchanged_credential() {
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let port = listener.local_addr().unwrap().port();
+    listener.set_nonblocking(true).unwrap();
+    let peer = std::thread::spawn(move || {
+        let runtime = tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();
+        runtime.block_on(async {
+            let listener = tokio::net::TcpListener::from_std(listener).unwrap();
+            let (stream, _) = listener.accept().await.unwrap();
+            tokio::time::timeout(std::time::Duration::from_secs(5), scripted_peer(stream, false, false)).await.unwrap()
+        })
+    });
+    let mut credential = RpPairingFileHandle(RpPairingFile::generate("GoFlyTest"));
+    let before = credential.0.to_bytes();
+    let mut address: libc::sockaddr_in = unsafe { std::mem::zeroed() };
+    address.sin_family = libc::AF_INET as _;
+    address.sin_port = port.to_be();
+    address.sin_addr.s_addr = u32::from_ne_bytes([127, 0, 0, 1]);
+    let mut adapter = std::ptr::dangling_mut();
+    let mut handshake = std::ptr::dangling_mut();
+    let error = unsafe { tunnel_create_rppairing_verify_only(
+        &address as *const _ as *const idevice_sockaddr,
+        std::mem::size_of_val(&address) as _, c"GoFlyTest".as_ptr(), &mut credential,
+        &mut adapter, &mut handshake,
+    ) };
+    assert!(!error.is_null());
+    assert_eq!(unsafe { (*error).code }, 103);
+    assert_eq!(unsafe { (*error).sub_code }, 5);
+    unsafe { crate::idevice_error_free(error) };
+    assert!(adapter.is_null());
+    assert!(handshake.is_null());
+    assert_eq!(credential.0.to_bytes(), before);
+    assert_verify_only(&peer.join().unwrap());
+}
+
+#[test]
+fn gofly_verify_only_export_invalid_arguments_clear_valid_outputs() {
+    let mut adapter = std::ptr::dangling_mut();
+    let mut handshake = std::ptr::dangling_mut();
+    let error = unsafe { tunnel_create_rppairing_verify_only(
+        std::ptr::null(), 0, std::ptr::null(), std::ptr::null_mut(), &mut adapter, &mut handshake,
+    ) };
+    assert!(!error.is_null());
+    unsafe { crate::idevice_error_free(error) };
+    assert!(adapter.is_null());
+    assert!(handshake.is_null());
+    let error = unsafe { tunnel_create_rppairing_verify_only(
+        std::ptr::null(), 0, std::ptr::null(), std::ptr::null_mut(), std::ptr::null_mut(), &mut handshake,
+    ) };
+    assert!(!error.is_null());
+    unsafe { crate::idevice_error_free(error) };
+    assert!(handshake.is_null());
+}
