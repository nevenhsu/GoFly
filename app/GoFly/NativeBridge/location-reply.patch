+#[test]
+fn gofly_location_wrong_id_then_matching_reply_uses_matching_reply() {
+    scenario(|mut peer| Box::pin(async move {
+        begin(&mut peer).await;
+        let request=Message::from_reader(&mut peer).await.unwrap();
+        reply(&mut peer,&request,4,Some(archive(Value::Dictionary(Dictionary::new()),Some("NSError"))),100,0,1,false).await;
+        reply(&mut peer,&request,0,None,0,0,1,false).await;
+    }), |handle| unsafe { assert!(location_simulation_set(handle,37.5,-122.25).is_null()); });
+}
