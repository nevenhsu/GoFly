+#[test]
+fn gofly_location_overall_timeout_and_late_point_cannot_ack_clear() {
+    unsafe { idevice_set_global_timeout(1) };
+    struct RestoreTimeout;
+    impl Drop for RestoreTimeout { fn drop(&mut self) { unsafe { idevice_set_global_timeout(5) }; } }
+    let _restore=RestoreTimeout;
+    // A tiny stream fills during the point frame: the same deadline must bound
+    // send/flush, not only the later wait for a reply.
+    scenario_capacity(64, |mut peer| Box::pin(async move {
+        begin(&mut peer).await;
+        tokio::time::sleep(Duration::from_millis(1250)).await;
+    }), |handle| unsafe {
+        let start=Instant::now();
+        let error=location_simulation_set(handle,37.5,-122.25); assert!(!error.is_null());
+        assert_eq!((*error).code,109); idevice_error_free(error);
+        assert!(start.elapsed() < Duration::from_millis(1500));
+        std::thread::sleep(Duration::from_millis(300));
+    });
+    // Silence and unsolicited conversation-0 frames cannot extend one deadline.
+    for unsolicited in [false, true] {
+        scenario(move |mut peer| Box::pin(async move {
+            begin(&mut peer).await;
+            let point=Message::from_reader(&mut peer).await.unwrap(); assert_point(&point);
+            for _ in 0..55 {
+                if unsolicited { reply(&mut peer,&point,0,None,100,0,0,false).await; }
+                tokio::time::sleep(Duration::from_millis(20)).await;
+            }
+        }), |handle| unsafe {
+            let start=Instant::now();
+            let error=location_simulation_set(handle,37.5,-122.25); assert!(!error.is_null());
+            assert_eq!((*error).code,109); idevice_error_free(error);
+            assert!(start.elapsed() < Duration::from_millis(1500));
+            // Leave the transport owned until the scripted traffic finishes;
+            // the assertion above measures only the actual native deadline.
+            std::thread::sleep(Duration::from_millis(250));
+        });
+    }
+    scenario(|mut peer| Box::pin(async move {
+        begin(&mut peer).await;
+        let point=Message::from_reader(&mut peer).await.unwrap(); assert_point(&point);
+        // Wrong IDs continue arriving; they must not satisfy or extend the deadline.
+        for _ in 0..55 {
+            reply(&mut peer,&point,0,None,100,0,1,false).await;
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+        let clear=Message::from_reader(&mut peer).await.unwrap();
+        assert_eq!(clear.data.as_ref().and_then(Value::as_string),Some("stopLocationSimulation"));
+        reply(&mut peer,&point,0,None,0,0,1,false).await;
+        // Actual clear reply is an error: a late point ACK must not hide it.
+        reply(&mut peer,&clear,4,Some(archive(Value::Dictionary(Dictionary::new()),Some("NSError"))),0,0,1,false).await;
+    }), |handle| unsafe {
+        let start=Instant::now();
+        let error=location_simulation_set(handle,37.5,-122.25); assert!(!error.is_null());
+        assert_eq!((*error).code,109); idevice_error_free(error);
+        assert!(start.elapsed() < Duration::from_millis(1500));
+        let error=location_simulation_clear(handle); assert!(!error.is_null()); idevice_error_free(error);
+    });
+}
