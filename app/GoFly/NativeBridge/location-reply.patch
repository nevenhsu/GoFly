+//! Scripted DTX peer tests exercise the actual C exports, framing and decoder.
+use crate::{dvt::{location_simulation::*, remote_server::*}, *};
+use idevice::dvt::message::{Message, MessageHeader, PayloadHeader, AuxValue};
+use plist::{Dictionary, Uid, Value};
+use std::{io::Cursor, ptr::null_mut, time::{Duration, Instant}};
+use tokio::io::{AsyncWriteExt, DuplexStream};
+
+fn archive(root: Value, classes: Option<&str>) -> Vec<u8> {
+    let mut objects = vec![Value::String("$null".into())];
+    let root_id = if let Some(class_name) = classes {
+        let mut object = root.into_dictionary().unwrap();
+        object.insert("$class".into(), Value::Uid(Uid::new(2)));
+        objects.push(Value::Dictionary(object));
+        let mut class = Dictionary::new();
+        class.insert("$classname".into(), Value::String(class_name.into()));
+        class.insert("$classes".into(), Value::Array(vec![Value::String(class_name.into()), Value::String("NSObject".into())]));
+        objects.push(Value::Dictionary(class));
+        1
+    } else if root.as_string() == Some("$null") { 0 } else { objects.push(root); 1 };
+    let mut top = Dictionary::new(); top.insert("root".into(), Value::Uid(Uid::new(root_id)));
+    let mut value = Dictionary::new();
+    value.insert("$archiver".into(), Value::String("NSKeyedArchiver".into()));
+    value.insert("$version".into(), Value::Integer(100000.into()));
+    value.insert("$top".into(), Value::Dictionary(top));
+    value.insert("$objects".into(), Value::Array(objects));
+    let mut bytes = Vec::new(); Value::Dictionary(value).to_writer_binary(&mut bytes).unwrap(); bytes
+}
+
+fn identifier(message: &Message) -> u32 {
+    u32::from_le_bytes(message.message_header.serialize()[16..20].try_into().unwrap())
+}
+
+async fn reply(peer: &mut DuplexStream, request: &Message, kind: u8, raw: Option<Vec<u8>>, id_delta: u32, channel_delta: i32, conversation: u32, expects: bool) {
+    let header = MessageHeader::new(0, 1, identifier(request) + id_delta, conversation,
+        -request.message_header.channel + channel_delta, expects);
+    let mut frame = Message::new(header, PayloadHeader::new(), None, None).serialize();
+    let raw = raw.unwrap_or_default();
+    frame[12..16].copy_from_slice(&(16_u32 + raw.len() as u32).to_le_bytes());
+    frame[32] = kind;
+    frame[40..44].copy_from_slice(&(raw.len() as u32).to_le_bytes());
+    frame.extend(raw);
+    peer.write_all(&frame).await.unwrap(); peer.flush().await.unwrap();
+}
+
+async fn begin(peer: &mut DuplexStream) {
+    let hello = Message::new(MessageHeader::new(0,1,0,0,0,false), PayloadHeader::new(), None, None);
+    peer.write_all(&hello.serialize()).await.unwrap();
+    let request = Message::from_reader(peer).await.unwrap();
+    assert_eq!(request.data.as_ref().and_then(Value::as_string), Some("_requestChannelWithCode:identifier:"));
+    reply(peer, &request, 0, None, 0, 0, 1, false).await;
+}
+
+fn assert_point(request: &Message) {
+    assert_eq!(request.data.as_ref().and_then(Value::as_string), Some("simulateLocationWithLatitude:longitude:"));
+    assert_eq!(&request.message_header.serialize()[28..32], &1_u32.to_le_bytes());
+    let args = &request.aux.as_ref().unwrap().values;
+    assert_eq!(args.len(), 2);
+    for (argument, expected) in args.iter().zip([37.5, -122.25]) {
+        let AuxValue::Array(bytes) = argument else { panic!("expected archived coordinate") };
+        let encoded = Value::from_reader(Cursor::new(bytes)).unwrap();
+        let encoded = encoded.as_dictionary().unwrap();
+        let objects = encoded["$objects"].as_array().unwrap();
+        let root = encoded["$top"].as_dictionary().unwrap()["root"].as_uid().unwrap().get() as usize;
+        assert_eq!(objects[root].as_real(), Some(expected));
+    }
+}
+
+fn scenario(action: impl FnOnce(DuplexStream) -> std::pin::Pin<Box<dyn std::future::Future<Output=()> + Send>> + Send + 'static,
+    check: impl FnOnce(*mut LocationSimulationHandle<'static>)) {
+    scenario_capacity(65536, action, check);
+}
+
+fn scenario_capacity(capacity: usize,
+    action: impl FnOnce(DuplexStream) -> std::pin::Pin<Box<dyn std::future::Future<Output=()> + Send>> + Send + 'static,
+    check: impl FnOnce(*mut LocationSimulationHandle<'static>)) {
+    let (client, peer) = tokio::io::duplex(capacity);
+    let server = std::thread::spawn(move || {
+        tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap().block_on(async {
+            tokio::time::timeout(Duration::from_secs(4), action(peer)).await.unwrap();
+        });
+    });
+    let socket = Box::into_raw(Box::new(ReadWriteOpaque { inner: Some(Box::new(client)) }));
+    let mut remote = null_mut(); let mut location = null_mut();
+    unsafe {
+        let error = remote_server_new(socket, &mut remote); assert!(error.is_null());
+        // remote_server_new borrows this wrapper and takes only its inner stream.
+        drop(Box::from_raw(socket));
+        let error = location_simulation_new(remote, &mut location); assert!(error.is_null());
+        check(location);
+        location_simulation_free(location); remote_server_free(remote);
+    }
+    server.join().unwrap();
+}
+
+#[test]
+fn gofly_location_supported_void_profiles_and_actual_c_exports() {
+    let profiles = [(0,None), (3,None), (3,Some(archive(Value::String("$null".into()),None))),
+        (3,Some(archive(Value::Dictionary(Dictionary::new()),Some("NSNull"))))];
+    for (kind, payload) in profiles {
+        scenario(move |mut peer| Box::pin(async move {
+            begin(&mut peer).await;
+            for selector in ["simulateLocationWithLatitude:longitude:", "stopLocationSimulation"] {
+                let request = Message::from_reader(&mut peer).await.unwrap();
+                assert_eq!(request.data.as_ref().and_then(Value::as_string), Some(selector));
+                if selector.starts_with("simulate") { assert_point(&request); }
+                reply(&mut peer,&request,kind,payload.clone(),0,0,1,false).await;
+            }
+        }), |handle| unsafe {
+            assert!(location_simulation_set(handle,37.5,-122.25).is_null());
+            assert!(location_simulation_clear(handle).is_null());
+        });
+    }
+}
+
+#[test]
+fn gofly_location_rejects_remote_error_and_nonvoid_profiles() {
+    let profiles = [(4,Some(archive(Value::Dictionary(Dictionary::new()),Some("NSError")))),
+        (3,Some(archive(Value::Dictionary(Dictionary::new()),Some("NSDictionary")))),
+        (3,Some(archive(Value::Dictionary(Dictionary::new()),Some("NSError")))),
+        (3,Some(archive(Value::Boolean(false),None))), (0,Some(archive(Value::String("$null".into()),None))),
+        (3,Some(vec![0,1,2,3]))];
+    for (kind,payload) in profiles {
+        scenario(move |mut peer| Box::pin(async move {
+            begin(&mut peer).await;
+            let request = Message::from_reader(&mut peer).await.unwrap(); assert_point(&request);
+            reply(&mut peer,&request,kind,payload,0,0,1,false).await;
+        }), |handle| unsafe {
+            let error=location_simulation_set(handle,37.5,-122.25);
+            assert!(!error.is_null(), "remote error/nonvoid reply must never confirm a point");
+            idevice_error_free(error);
+        });
+    }
+}
