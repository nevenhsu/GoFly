+#[test]
+fn gofly_location_mismatched_channel_conversation_and_expects_fail() {
+    for (channel,conversation,expects) in [(1,1,false),(0,3,false),(0,1,true)] {
+        scenario(move |mut peer| Box::pin(async move {
