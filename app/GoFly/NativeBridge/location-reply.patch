+//! GoFly's bounded void reply profile. See pymobiledevice3 primary source at
+//! 06f3c1c786e11b94c5e20f7d31a3b283f133fa0c: dtx/channel.py, _sender.py,
+//! ns_types.py. Both empty OK and OBJECT nil/NSNull are supported.
+use super::Message;
+use crate::IdeviceError;
+use plist::Value;
+use std::io::Cursor;
+
+impl Message {
+    pub(crate) fn validate_void_reply(&self, identifier: u32, channel: i32) -> Result<(), IdeviceError> {
+        let header = &self.message_header;
+        let payload = &self.payload_header;
+        let envelope = header.identifier == identifier && header.channel == channel
+            && header.conversation_index == 1 && !header.expects_reply
+            && payload.aux_length == 0 && self.aux.is_none()
+            && payload.flags_a == 0 && payload.flags_b == 0 && payload.reserved == 0 && payload.flags == 0;
+        let empty = payload.total_length == 0 && self.data.is_none() && self.raw_data.is_none();
+        let accepted = match payload.msg_type {
+            0 => empty,
+            3 => empty || self.raw_data.as_ref().is_some_and(|raw| {
+                payload.total_length as usize == raw.len() && archive_is_null(raw)
+            }),
+            _ => false,
+        };
+        if envelope && accepted { return Ok(()); }
+        // Never publish a raw remote NSError or archive in a native error.
+        Err(IdeviceError::UnexpectedResponse("location command reply was not a confirmed void result".into()))
+    }
+}
+
+fn archive_is_null(bytes: &[u8]) -> bool {
+    // The pinned decoder conflates `$null` and empty NSDictionary. Inspect the
+    // archive root and class identity instead of the lossy decoded Value.
+    let Ok(Value::Dictionary(archive)) = Value::from_reader(Cursor::new(bytes)) else { return false };
+    if archive.get("$archiver").and_then(Value::as_string) != Some("NSKeyedArchiver") { return false; }
+    if archive.get("$version").and_then(Value::as_unsigned_integer) != Some(100000) { return false; }
+    let Some(objects) = archive.get("$objects").and_then(Value::as_array) else { return false };
+    let Some(root) = archive.get("$top").and_then(Value::as_dictionary)
+        .and_then(|top| top.get("root")).and_then(Value::as_uid) else { return false };
+    let Ok(mut index) = usize::try_from(root.get()) else { return false };
+    // Bound UID indirection and reject cycles without recursively decoding data.
+    let mut visited = std::collections::HashSet::new();
+    for _ in 0..32 {
+        if !visited.insert(index) { return false; }
+        match objects.get(index) {
+            Some(Value::Uid(next)) => {
+                let Ok(next) = usize::try_from(next.get()) else { return false }; index = next;
+            }
+            Some(Value::String(value)) => return index == 0 && value == "$null",
+            Some(Value::Dictionary(value)) if value.len() == 1 => {
+                let Some(class) = value.get("$class").and_then(Value::as_uid) else { return false };
+                let Ok(class) = usize::try_from(class.get()) else { return false };
+                let Some(class) = objects.get(class).and_then(Value::as_dictionary) else { return false };
+                return class.get("$classname").and_then(Value::as_string) == Some("NSNull")
+                    && class.get("$classes").and_then(Value::as_array)
+                        .is_some_and(|classes| classes.iter().any(|name| name.as_string() == Some("NSNull")));
+            }
+            _ => return false,
+        }
+    }
+    false
+}
