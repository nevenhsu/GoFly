PRODUCT_BUNDLE_IDENTIFIER = com.neven.gofly
PRODUCT_NAME = GoFly
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 2
IPHONEOS_DEPLOYMENT_TARGET = 26.0
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_EMIT_LOC_STRINGS = YES
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = GoFly
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = Show your location and center the map when you ask.
INFOPLIST_KEY_NSLocalNetworkUsageDescription = GoFly connects to this iPhone through your local VPN tunnel.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIFileSharingEnabled = NO
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace = NO
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
SWIFT_INCLUDE_PATHS[sdk=iphoneos*] = $(inherited) $(PROJECT_DIR)/NativeBridge/include
LIBRARY_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) $(PROJECT_DIR)/../../work/gofly-ios/native
OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) -lidevice_ffi -lz -liconv -lsqlite3 -framework Security -framework SystemConfiguration
DEAD_CODE_STRIPPING = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
